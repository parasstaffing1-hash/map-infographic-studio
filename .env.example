# Browser application
VITE_PRODUCTION_API_URL=http://127.0.0.1:8787

# Production API and queue
NODE_ENV=production
PORT=8787
RENDERER_PORT=8788
HOST=0.0.0.0
REDIS_URL=redis://redis:6379
QUEUE_NAME=map-studio-render-shards
API_KEYS=replace-with-a-long-random-api-key
INTERNAL_RENDER_TOKEN=replace-with-a-different-long-random-token
CORS_ORIGINS=https://maps.example.com
MANIFEST_ALLOWED_HOSTS=data.example.com
MAX_SHARDS_PER_BATCH=10000
MAX_RECORDS_PER_SHARD=5000
WORKER_CONCURRENCY=8
RECORD_CONCURRENCY=4
STATUS_TTL_SECONDS=2592000

# Renderer
WEB_APP_URL=http://web
RENDERER_URL=http://renderer:8788
RENDER_TIMEOUT_MS=45000
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
OUTPUT_DIRECTORY=/data/outputs

# S3-compatible object storage (recommended in production)
S3_BUCKET=map-studio-renders
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Video rendering (API + video worker)
VIDEO_QUEUE_NAME=map-studio-video-jobs
# Simultaneous video jobs per worker process. Each job drives one browser context.
VIDEO_WORKER_CONCURRENCY=2
# Hard ceiling on a single FFmpeg encode before the process is killed.
VIDEO_ENCODE_TIMEOUT_MS=600000
# Absolute path or bare command name. The worker refuses to start if this is unusable.
FFMPEG_PATH=ffmpeg
# Prefix used to build the downloadUrl reported for a finished video.
# Point it at the public base of your object store or CDN, not at the API.
PUBLIC_DOWNLOAD_BASE_URL=https://cdn.example.com/renders

# Per-API-key hourly quotas (fixed window)
VIDEO_JOBS_PER_KEY_PER_HOUR=60
BATCH_JOBS_PER_KEY_PER_HOUR=120

# Accounts, workspaces and projects (application tier)
DATABASE_URL=postgres://mapstudio:replace-me@postgres:5432/mapstudio
SESSION_TTL_HOURS=720
APP_BASE_URL=https://studio.example.com
APP_API_PUBLIC_URL=https://api.example.com

# Local Postgres credentials used by docker-compose
POSTGRES_USER=mapstudio
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=mapstudio
# Change if a local PostgreSQL already owns 5432 on your machine
POSTGRES_HOST_PORT=5432

# Download links. Renders are stored privately and handed out as short-lived
# presigned URLs, so the bucket must NOT be public in production.
S3_PUBLIC_ENDPOINT=https://objects.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
DOWNLOAD_URL_TTL_SECONDS=900
